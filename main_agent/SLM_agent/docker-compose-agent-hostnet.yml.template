# Template for docker-compose with host networking
# This allows the agent to access localhost services on the host
services:
  agent:
    image: slm-agent-8001
    network_mode: host
    volumes:
      - ./docs:/code/docs
      - ./rtl:/code/rtl
      - ./verif:/code/verif
      - ./rundir:/code/rundir
      - ./prompt.json:/code/prompt.json
    working_dir: /code
    environment:
      # With host networking, localhost means the actual host
      - SLM_API_URL=http://localhost:8001
      - SLM_MODEL=granite
      - SLM_MAX_LENGTH=8192
      - SLM_TIMEOUT=3000
